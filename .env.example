GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=
# token store reused between runs (MFA-safe)
GARMINTOKENS=~/.garminconnect
SPREADSHEET_ID=
# Google user OAuth (scripts/get_google_token.py)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# or a service account: GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json / GOOGLE_SERVICE_ACCOUNT_JSON=
# Garmin -> Google Calendar (pipeline garmin-to-calendar; needs the token above to carry the Calendar scope)
GOOGLE_CALENDAR_ID=                  # calendar id; empty -> look up by name, then 'primary'
GOOGLE_CALENDAR_NAME=Дневник         # calendar name to look up when GOOGLE_CALENDAR_ID is empty
CALENDAR_KINDS=activity,sleep,nap,weight,blood_pressure,daily  # record kinds turned into events
CALENDAR_TIMEZONE=                   # empty -> the calendar's own timezone
CALENDAR_SUMMARY_PREFIX=             # optional prefix for every event title
CALENDAR_PRIVATE=true                # mark events visibility=private
GARMIN_CALENDAR_DAYS=7               # first-run window for sleep/daily when there is no cursor yet
CALENDAR_POINT_MINUTES=10            # length of a timed measurement event (weight, pressure)
GARMIN_CALENDAR_ACTIVITY_DAYS=7      # first-run activity window; 0 = the whole history
CALENDAR_WRITE_DELAY=0.5             # pause between calendar writes (a burst trips Google's quota)
CALENDAR_WRITE_RETRIES=6             # retries with exponential backoff on 403 rateLimitExceeded / 429 / 5xx
GARMIN_ACTIVITY_LIMIT=100            # activity page cap; 0 = no cap (needed with the window above set to 0)
